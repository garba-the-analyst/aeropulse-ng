{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroPulse-NG",
  "version": "0.1.0",
  "identifier": "com.aeropulse.ng",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "radar_main",
        "title": "AeroPulse-NG :: Tactical Radar Canvas",
        "url": "/index.html",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "ops_hud",
        "title": "AeroPulse-NG :: Operations & Weather HUD",
        "url": "/hud.html",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
